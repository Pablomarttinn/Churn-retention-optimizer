# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
*.egg-info/
dist/
build/
*.egg

# Entorno virtual
.venv/
.env

# uv
.python-version

# Datos (no versionar datasets)
data/raw/
# `data/processed/*` y no `data/processed/`: con la forma de directorio git no
# desciende dentro y la negacion de abajo nunca se evaluaria.
data/processed/*
# Excepcion: el unico fichero que el dashboard lee en runtime. Se versiona para
# que el deploy no necesite el CSV crudo. Regenerable con
# scripts/build_dashboard_data.py
!data/processed/dashboard_data.csv

# Modelos serializados (solo la carpeta de la raiz, no src/**/models/)
/models/

# Jupyter
.ipynb_checkpoints/

# Linters / formatters
.ruff_cache/
.mypy_cache/

# Tests
.pytest_cache/
htmlcov/
.coverage

